# Copy to .env and fill in. Never commit .env.
# Optional, paid. Extraction uses the free Groq key below unless EXTRACT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Model used to read the studies
ETHNO_MODEL=claude-opus-5-5
# Optional: raises the PubMed rate limit from 3 to 10 requests/second
NCBI_API_KEY=
NCBI_EMAIL=
# Optional: free token from https://api.iucnredlist.org
IUCN_TOKEN=
# Free key from https://console.groq.com/keys: study extraction and the "Ask the librarian" chat
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Extraction model and chunk size (free tier: keep chunks small)
GROQ_EXTRACT_MODEL=openai/gpt-oss-120b
GROQ_PAGES_PER_CALL=2
# groq (default when GROQ_API_KEY is set) or anthropic
EXTRACT_PROVIDER=
# Optional, free (non-commercial): photo identification on the Plant profile page. Key at https://my.plantnet.org/
PLANTNET_API_KEY=
